{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://106.55.55.54:8002/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Connection", "value": "Upgrade" },
        { "key": "Upgrade", "value": "websocket" }
      ]
    }
  ]
}